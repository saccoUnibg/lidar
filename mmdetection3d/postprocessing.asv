%% Struttura folder
%
%   /lidar
%       /mmdetection3d
%           /workspaces
%           inference.m
%           postprocessing.m
%       /tests
%           /test01 ...
%
%% 2. Postprocessing
root = '/Users/cristiansacco/workspaces/lidar/mmdetection3d';
cd(root)
clc;clear; close all;

test = "10";
bike_type = "bici_corsa";
% bike_type = "mtb";

% - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

% --- Workspace + path ---
workspace_filename = "workspaces/" + bike_type + "/workspace_"+ test +".mat";
load(workspace_filename);
path = "../tests/" + bike_type + "/test" + test;
% --- Model name ---
model = "second";
root = '/Users/cristiansacco/workspaces/lidar/mmdetection3d';
% Filter cyclists results
close all;
threshold = 0.4;
results_filtered = postprocessing_functions.filter_cyclist(results,model,threshold);
% Estrazione punti interni alle bb + pcd traiettoria
[pcd_list, pcd_traiettoria,center_list] = postprocessing_functions.extract_points_from_bb(path, results_filtered);
% salvataggio pcd sole bici in cartella pcd_classification
postprocessing_functions.export_bike_pcd(pcd_list,root,test,bike_type);
%% 1. Visualizzazione traiettoria
close all;
ax = postprocessing_functions.get_trajectory(pcd_list,center_list);

% 1) Recuperiamo subito l'handle della traiettoria REALE (rossa)
% Cerchiamo le linee nel grafico. 
hLines = findobj(ax, 'Type', 'line');
if ~isempty(hLines)
    hReal = hLines(1); % Prendiamo la prima trovata
    set(hReal, 'Color', 'r', 'LineWidth', 2); % Assicuriamo che sia rossa
else
    hReal = [];
end

% --- Gestione Traiettoria Ideale ---
checkbox = 1;
hIdeal = []; 

if checkbox == 1
    hold(ax,'on');
    ideal_trajectory = openfig("/Users/cristiansacco/workspaces/lidar/tests/bici_corsa/test12/test12_traiettoria.fig",'invisible');
    axIdeal = findobj(ideal_trajectory, 'Type', 'axes');
    hLineIdeal = findobj(axIdeal, 'Type', 'line');
    
    % Copio la linea nella mia axes attuale
    hIdeal = copyobj(hLineIdeal, ax);
    
    % Stile VERDE per la ideale
    set(hIdeal, 'Color', 'green', 'LineStyle', '-', 'LineWidth', 3);
    
    close(ideal_trajectory);
    hold off;
end

% --- SEZIONE FORMATTAZIONE ASSI E LEGENDA ---

% 1. IMPOSTAZIONE LABEL ASSI (Nomi e Grandezza)
% Scriviamo esplicitamente i nomi degli assi (puoi cambiare 'X', 'Y', 'Z' se vuoi altro)
xlabel(ax, 'X [m]', 'FontSize', 20, 'FontWeight', 'bold');
ylabel(ax, 'Y [m]', 'FontSize', 20, 'FontWeight', 'bold');
zlabel(ax, 'Z [m]', 'FontSize', 20, 'FontWeight', 'bold');

% Ingrandiamo anche i numeri sugli assi (ticks)
ax.FontSize = 14; 
ax.FontWeight = 'bold';
grid(ax, 'on'); % Griglia attiva per leggere meglio

% 2. CREAZIONE LEGENDA
% Costruiamo la legenda solo se abbiamo gli oggetti grafici
linesToLegend = [];
namesToLegend = {};

if ~isempty(hReal)
    linesToLegend = [linesToLegend, hReal];
    namesToLegend{end+1} = 'Real Trajectory';
end

if ~isempty(hIdeal)
    linesToLegend = [linesToLegend, hIdeal];
    namesToLegend{end+1} = 'Ideal Trajectory';
end

if ~isempty(linesToLegend)
    lgd = legend(linesToLegend, namesToLegend);
    lgd.FontSize = 16;        % Grandezza testo legenda
    lgd.Location = 'best';    % Posizione ottimale
end
%% 2. Analisi dinamica: Calcolo velocita' e distanza percorsa
[covered_distance, speed_array, speed_max,speed_mean] = postprocessing_functions.get_distance_and_speed(pcd_list);
disp("Covered Distance: " + covered_distance + " m");
disp("Speed (max): " + speed_max + " km/h");
disp("Speed (mean): " + speed_mean + " km/h");

%% 3. Analisi statica: Inclinazione bici
[ground_equation_list, bike_equation_list, angle_list] = postprocessing_functions.get_inclination(path,results_filtered, pcd_list);
%% 3bis: calcolo pendenza terreno
grond_slope_list = postprocessing_functions.get_ground_slope(ground_equation_list);
%% 3a. plot each pcd with planes
clc;close all;
postprocessing_functions.plot_pcd_ground_single(ground_equation_list, bike_equation_list, pcd_list,angle_list);
%% 3b. plot all pcd with planes
clc;close all;
postprocessing_functions.plot_pcd_ground_sequence(ground_equation_list,bike_equation_list,pcd_list,angle_list);
%% 4. Classificazione 2 features: bici corsa/mountain bike

postprocessing_functions.classification(path,results_filtered,pcd_list);
%% 000. Extra: Show results bounding box in point cloud
close all;
lim = 0;
postprocessing_functions.show_results(path,results_filtered,threshold,lim);
%% 000: Extra: Mostrare pcd solo ciclista + bici
path_pcd_bici = "/Users/cristiansacco/workspaces/lidar/mmdetection3d/pcd_classification/"+bike_type+"/test"+test;
inference_functions.show_pcd_from_path(path_pcd_bici);

%% 000: Misc
close all;

% 1. grafico scores inferenza
figure(1);
media_punteggi = mean([results_filtered.scores]);
plot([results_filtered.scores],YDataSource = '[results_filtered.scores]');
linkdata on;
str_mean_value = "Average score: " + media_punteggi;
yline(media_punteggi,'r--',str_mean_value);
ylabel("[score]");
title("[Scores over acquisition]");
ylim([0,1])

hold on;

% 2. grafico punti per pcd -> diminuiscono con pcd lontane
figure(2);
% calcolo numero punti bici per test
pts_sizes = zeros(size(pcd_list,1),1);
for i =1 : size(pcd_list,1)
    if ~isempty(pcd_list{i})
        pts_sizes(i) = size(pcd_list{i}.Location,1);
    end
end
% calcolo distanza euclidea dal sensore con center_list
% Calcolo distanza euclidea dal sensore
distance_list = zeros(size(center_list, 1), 1);
distance_list = sqrt(sum(center_list.^2, 2));

distance_list(distance_list == 0) = [];
pts_sizes(pts_sizes == 0) = [];

yyaxis left
plot(distance_list, 'LineWidth', 1.5)
ylabel('Distanza dal centro')

yyaxis right
plot(pts_sizes, 'LineWidth', 1.5)
ylabel('Numero di punti')

xlabel('Tempo')
title('Relazione distanza e numero di punti')

% 3. grafico velocità
% Calcolo velocità media e massima
figure (3)
plot(speed_array, 'LineWidth', 1.5)
ylabel('Speed (km/h)')
xlabel('Frames')
% aggiunta di linea che descrive meglio l'array di punti come curva
% Aggiunta di una linea che descrive meglio l'array di punti come curva
hold on;
plot(smooth(speed_array), 'LineWidth', 2, 'Color', 'g');
legend('Speed (km/h)', 'Smoothed Speed');

%%

